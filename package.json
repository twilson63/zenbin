{
  "name": "zenbin",
  "version": "1.0.0",
  "description": "A headless HTML sandbox - publish and serve HTML documents via API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx tsc",
    "start": "node -r dotenv/config dist/index.js",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node --test scripts/logs.e2e.mjs"
  },
  "keywords": [
    "html",
    "sandbox",
    "api",
    "hosting"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.12.16",
    "jsonwebtoken": "^9.0.2",
    "lmdb": "^3.1.5",
    "posthog-node": "^5.26.0",
    "stripe": "^22.1.1",
    "tldts": "^7.4.9",
    "undici": "^6.26.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
