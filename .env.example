# ZenBin Configuration

# Server
PORT=3000
HOST=0.0.0.0

# Base URL for generating links (no trailing slash)
BASE_URL=http://localhost:3000

# Storage
LMDB_PATH=./data/zenbin.lmdb

# Auth
# Required for JWT-based API key verification (legacy path).
# Primary auth is Ed25519 signed requests — this is only needed for portal-issued keys.
# Generate: openssl rand -base64 32
ZENBIN_JWT_SECRET=

# Admin API access token — CHANGE THIS to a random secret in production.
# Generate: openssl rand -base64 32
ADMIN_TOKEN=

# Limits
MAX_PAYLOAD_SIZE=524288
MAX_ID_LENGTH=128

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Proxy
PROXY_TIMEOUT_MS=30000
PROXY_MAX_REQUEST_SIZE=5242880
PROXY_MAX_RESPONSE_SIZE=5242880
PROXY_ALLOWED_DOMAINS=
PROXY_RATE_LIMIT_MAX=5
PROXY_RATE_LIMIT_WINDOW_MS=60000
PROXY_MAX_REDIRECTS=3

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_PORTAL_RETURN_URL=
